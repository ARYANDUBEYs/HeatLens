# HeatLens × Microsoft Imagine Cup 2026
# Frontend Environment Configuration Template

# Azure OpenAI Service (GPT-4o / GPT-4o-mini)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Azure Cosmos DB (Ward Metrics & Telemetry)
AZURE_COSMOS_CONNECTION_STRING=your_cosmos_conn_str
AZURE_COSMOS_DB_NAME=heatlens
AZURE_COSMOS_CONTAINER_NAME=ward_metrics

# Azure Blob Storage (GeoTIFFs & GeoJSON Telemetry Layers)
AZURE_STORAGE_CONNECTION_STRING=your_blob_storage_conn_str
AZURE_STORAGE_CONTAINER_NAME=processed-telemetry

# Azure Maps Subscription Key (Central India)
NEXT_PUBLIC_AZURE_MAPS_KEY=your_azure_maps_subscription_key_here
